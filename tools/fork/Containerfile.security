ARG SECURITY_BASE_IMAGE
FROM ${SECURITY_BASE_IMAGE}
COPY ca-trust /opt/ca-trust
RUN find /opt/ca-trust -type d -exec chmod 0755 {} + && find /opt/ca-trust -type f -exec chmod 0644 {} +
RUN apt-get update -o APT::Update::Error-Mode=any -o Acquire::https::CaInfo=/opt/ca-trust/transport.crt -o Acquire::https::Verify-Peer=true -o Acquire::https::Verify-Host=true \
 && apt-get install -y --no-install-recommends -o Acquire::https::CaInfo=/opt/ca-trust/transport.crt ca-certificates openssl python3-pip python3-venv openjdk-17-jre-headless \
 && update-ca-certificates \
 && python3 -I /opt/ca-trust/verify_trust.py --system \
 && python3 -I /opt/ca-trust/bootstrap_image.py \
 && rm -rf /var/lib/apt/lists/* /opt/ca-trust/wheels /opt/ca-trust/transport.crt
COPY build-tools /opt/codex-build-tools
RUN install -m755 /opt/codex-build-tools/just /opt/codex-build-tools/uv /opt/codex-build-tools/dotslash /usr/local/bin/ \
 && printf '%s\n' '#!/bin/sh' 'if [ "${1-}" = --version ]; then exec /opt/codex-build-tools/bazel "$@"; fi' 'exec /opt/codex-build-tools/bazel --output_user_root=/source/.build/bazel --host_jvm_args=-Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts "$@"' > /usr/local/bin/bazel \
 && chmod 755 /usr/local/bin/bazel
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt SSL_CERT_DIR=/etc/ssl/certs CARGO_HTTP_CAINFO=/etc/ssl/certs/ca-certificates.crt RUSTUP_USE_CURL=1 RUSTUP_AUTO_INSTALL=0
