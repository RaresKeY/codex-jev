FROM docker.io/library/rust@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb
LABEL io.rareskey.retention="retain" io.rareskey.project="codex-jev" io.rareskey.purpose="rust-build-toolchain"
RUN apt-get update && apt-get install -y --no-install-recommends clang cmake pkg-config libssl-dev protobuf-compiler && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt
